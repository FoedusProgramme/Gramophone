<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AppWidget">
        <attr name="system_app_widget_background_radius" format="dimension" />
        <attr name="system_app_widget_inner_radius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="ThemeAttrs">
        <!-- The surface colours the lyrics, widgets and tinted drawables read from the theme. -->
        <attr name="colorSurface" format="color" />
        <attr name="colorOnSurface" format="color" />
        <attr name="colorSurfaceVariant" format="color" />
    </declare-styleable>
</resources>